{
  "name": "@hanzo/ast",
  "version": "1.0.0",
  "description": "Structured AI training data collection — captures interactions, feedback, and model outputs for AI model training pipelines.",
  "author": "Hanzo AI, Inc. <eng@hanzo.ai>",
  "license": "MIT",
  "homepage": "https://hanzo.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/ast.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node_modules/tsgo/bin/tsc --noEmit --incremental false"
  },
  "devDependencies": {
    "tsgo": "npm:typescript@7.0.2",
    "tsup": "^8.0.0",
    "typescript": "6.0.3"
  },
  "keywords": ["ai", "training-data", "analytics", "feedback", "hanzo"]
}
